# Secrets du projet
API_TOKEN=ipssi-marketplace-token

# Alerting échec DAG (optionnel) : URL Slack Incoming Webhook.
# Laissé vide -> repli automatique sur le webhook simulé de l'API marketplace.
ALERT_WEBHOOK_URL=

# Garage (stockage objet S3, remplace MinIO)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=ipssi-garage-admin-token
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=raw

# PostgreSQL Data Warehouse
DWH_USER=dwh
DWH_PASSWORD=dwh
DWH_DB=dwh

# PostgreSQL metadata Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Couche Big Data : log d'evenements (Redpanda / Kafka) ---
KAFKA_TOPIC=orders
EVENTS_PER_SEC=8

# Speed layer : fenetre glissante et seuil de detection
SPEED_WINDOW_SECONDS=60
SPEED_BASELINE_SECONDS=600
SPEED_DROP_THRESHOLD=0.30

# Archiveur : frequence d'ecriture des fichiers Parquet
ARCHIVE_FLUSH_EVENTS=500
ARCHIVE_FLUSH_SECONDS=60
