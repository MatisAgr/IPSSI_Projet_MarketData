# Secrets du projet
API_TOKEN=ipssi-marketplace-token

# Alerting échec DAG (optionnel) : URL Slack Incoming Webhook.
# Laissé vide -> repli automatique sur le webhook simulé de l'API marketplace.
ALERT_WEBHOOK_URL=

# Garage (stockage objet S3, remplace MinIO)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=ipssi-garage-admin-token
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=raw

# PostgreSQL Data Warehouse
DWH_USER=dwh
DWH_PASSWORD=dwh
DWH_DB=dwh

# PostgreSQL metadata Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
